        {
          "id": "blk_wa90btzgtm",
          "type": "text",
          "v": 1,
          "fields": {
            "content": {
              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "2007 debut short. Suggest watching with headphones, in the dark. 🎧◼️"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Not suitable for kids or work.",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " Depending on your work I suppose. Or indeed your kids."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "HDV (which felt "
                    },
                    {
                      "type": "text",
                      "text": "very",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " fancy back then)."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Made for £600 mostly in my back garden. Often out of focus."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "There was a \"spinning ground glass\" meant to give it a film look, except it quite often wasn't spinning."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "- Nominee for Best Film at London Short Film Festival"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "- Nominee for Best Newcomer at Rushes Film Festival"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "- Final 25 for Best British Short at the BIFAs"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "- Nominee for SAE Best Digital Short"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "- Featured on Time Out's DVD pick of the Week (remember those?)"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "\"Suggests the future of the British film industry may be in safe hands.\"",
                      "marks": [
                        {
                          "type": "italic"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " said Paul Dale in The List. Thanks Paul."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Penis by "
                    },
                    {
                      "type": "text",
                      "text": "13 Finger FX ",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://www.instagram.com/13fingerfx/",
                            "newTab": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "(don't go there if you're squeamish).."
                    }
                  ]
                },
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Powered by   Create your own unique website with customizable templates.  Get Started",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
