              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "an NYU Grad Film exercise"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Rules:"
                    },
