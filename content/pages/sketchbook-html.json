              "type": "doc",
              "content": [
                {
                  "type": "paragraph",
                  "content": [
                    {
                      "type": "text",
                      "text": "Class assignment for Darren Aronofsky. Shot alone on an iphone in an evening, cut that night."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Rules:"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Under 2 minutes."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Shoot alone."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Use whatever lo-fi tech you have to hand."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Track; Writers' Waltz by Krzysztof A. Janczak"
                    }
                  ]
                }
              ]
            }
          }
        },
        {
          "id": "blk_57jmfks7bs",
          "type": "embed",
          "v": 1,
          "fields": {
            "embed": {
              "type": "url",
              "url": "https://player.vimeo.com/video/1935272?color=ff9933"
            },
