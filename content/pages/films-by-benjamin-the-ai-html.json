                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ".",
                      "marks": [
                        {
                          "type": "bold"
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " 2016. The first film ever written entirely by an artificial intelligence."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Written by \"Benjamin\" - a collaboration with "
                    },
                    {
                      "type": "text",
                      "text": "Ross Goodwin",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "http://rossgoodwin.com/",
                            "newTab": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Starring Thomas Middleditch, Elisabeth Grey & Humphrey Ker. An "
                    },
                    {
                      "type": "text",
                      "text": "End Cue",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "http://endcue.com/",
                            "newTab": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": " production. Full "
                    },
                    {
                      "type": "text",
                      "text": "credits",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "http://www.imdb.com/title/tt5794766/fullcredits",
                            "newTab": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": "."
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "hardBreak"
                    },
                    {
                      "type": "text",
                      "text": "Get the screenplay "
                    },
                    {
                      "type": "text",
                      "text": "here",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "/media/files/sunspring-final-mkde.pdf"
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". Get hi-res stills "
                    },
                    {
                      "type": "text",
                      "text": "here",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://www.dropbox.com/sh/9x3pu4kc0ldeaqh/AAB0Ie75-dV6CMV5D6CMoYKOa?dl=0",
                            "newTab": true
                          }
                        }
                      ]
                    },
                    {
                      "type": "text",
                      "text": ". Get the song, also written by Benjamin, "
                    },
                    {
                      "type": "text",
                      "text": "here",
                      "marks": [
                        {
                          "type": "link",
                          "attrs": {
                            "href": "https://soundcloud.com/tigerandman/home-on-the-land",
                            "newTab": true
                          }
